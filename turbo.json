{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NEXTAUTH_SECRET",
    "DATABASE_URL",
    "WORKER_POLL_INTERVAL_MS",
    "PAYMENT_PENDING_TTL_MS",
    "PAYMENT_PROVIDER",
    "NEXUS_PAY_API_KEY",
    "NEXUS_PAY_WEBHOOK_SECRET",
    "NEXUS_PAY_API_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": []
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
