{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NEXTAUTH_SECRET",
    "DATABASE_URL",
    "WORKER_POLL_INTERVAL_MS",
    "PAYMENT_PENDING_TTL_MS",
    "PAYMENT_PROVIDER",
    "NEXUS_PAY_API_KEY",
    "NEXUS_PAY_WEBHOOK_SECRET",
    "NEXUS_PAY_API_BASE_URL",
    "NEXUS_PAY_TIMEOUT_MS",
    "MPESA_MODE",
    "MPESA_ENVIRONMENT",
    "MPESA_CONSUMER_KEY",
    "MPESA_CONSUMER_SECRET",
    "MPESA_SHORTCODE",
    "MPESA_PASSKEY",
    "MPESA_CALLBACK_URL",
    "MPESA_WEBHOOK_ALLOWED_IPS",
    "APP_URL",
    "MAIL_MODE",
    "MAIL_FROM",
    "RESEND_API_KEY",
    "EARNINGS_ADMIN_SECRET",
    "LOG_LEVEL",
    "LOG_PRETTY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXTAUTH_SECRET",
        "DATABASE_URL",
        "WORKER_POLL_INTERVAL_MS",
        "PAYMENT_PENDING_TTL_MS",
        "PAYMENT_PROVIDER",
        "NEXUS_PAY_API_KEY",
        "NEXUS_PAY_WEBHOOK_SECRET",
        "NEXUS_PAY_API_BASE_URL",
        "NEXUS_PAY_TIMEOUT_MS",
        "MPESA_MODE",
        "MPESA_ENVIRONMENT",
        "MPESA_CONSUMER_KEY",
        "MPESA_CONSUMER_SECRET",
        "MPESA_SHORTCODE",
        "MPESA_PASSKEY",
        "MPESA_CALLBACK_URL",
        "MPESA_WEBHOOK_ALLOWED_IPS",
        "APP_URL",
        "MAIL_MODE",
        "MAIL_FROM",
        "RESEND_API_KEY",
        "EARNINGS_ADMIN_SECRET",
        "LOG_LEVEL",
        "LOG_PRETTY"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": []
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
