{
  "name": "@earnchat/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-network-family-autoselection\" drizzle-kit migrate",
    "db:studio": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-network-family-autoselection\" drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@earnchat/config": "*",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11"
  }
}
