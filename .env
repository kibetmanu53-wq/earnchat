# ---------------------------------------------------------------------------
# EarnChat environment configuration
# Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database (PostgreSQL). Required.
DATABASE_URL=postgresql://neondb_owner:npg_zGPADubSi83F@ep-noisy-pond-b58wujkt-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Web app
NODE_ENV=development
APP_URL=http://localhost:3000

# Session signing/hashing secret, >= 32 random chars.
# Generate with: openssl rand -hex 32
SESSION_SECRET=be7575ae6341b701c56cb783b6b648dead013c5d43f9c8ed1d48ce73edb9576f


# Internal endpoint secret for crediting eligible-chat earnings, >= 32 chars.
# Generate separately from SESSION_SECRET.
EARNINGS_ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Payment provider
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=nexus_pay

# ---------------------------------------------------------------------------
# Secret API key from the Nexus Pay dashboard (sk_... or sb_..., never pk_...).
NEXUS_PAY_API_KEY=sk_d50c1ca25353724b2efd295062e52bf2e2bfb841ad8e06ec6e1c899f52ee1f15
# Webhook signing secret shown when the endpoint is created in the dashboard.
NEXUS_PAY_WEBHOOK_SECRET=whsec_de7eed6cc9a1f0ea2e0eec331551631f63b5354e0fa539b1
# API origin from the dashboard. Live API: https://makamescopay.com
NEXUS_PAY_API_BASE_URL=https://makamescopay.com/api/payments/stkpush
# Optional request timeout for Nexus Pay API calls.
NEXUS_PAY_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Worker (polls the database for pending payments)
# ---------------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=5000
PAYMENT_PENDING_TTL_MS=180000
