# ---------------------------------------------------------------------------
# EarnChat environment configuration
# Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database (PostgreSQL). Required.
DATABASE_URL=postgres://earnchat:earnchat@localhost:5432/earnchat

# Web app
NODE_ENV=development
APP_URL=http://localhost:3000

# Session signing/hashing secret, >= 32 random chars.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Internal endpoint secret for crediting eligible-chat earnings, >= 32 chars.
# Generate separately from SESSION_SECRET.
EARNINGS_ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Safaricom Daraja (M-Pesa)
# ---------------------------------------------------------------------------
# MPESA_MODE: "mock" simulates Daraja locally (no real prompts, no credentials).
# "live" uses the credentials below against sandbox or production.
MPESA_MODE=mock
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:3000/api/webhooks/mpesa

# ---------------------------------------------------------------------------
# Worker (polls the database for pending payments)
# ---------------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=5000
PAYMENT_PENDING_TTL_MS=180000
