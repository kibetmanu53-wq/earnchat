# ---------------------------------------------------------------------------
# EarnChat environment configuration
# Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database (PostgreSQL). Required.
DATABASE_URL=postgres://earnchat:earnchat@localhost:5432/earnchat

# Web app
NODE_ENV=development
APP_URL=http://localhost:3000

# Logging. Levels: debug, info, warn, error. Production emits single-line JSON;
# set LOG_PRETTY=1 to force human-readable output.
LOG_LEVEL=info

# Session signing/hashing secret, >= 32 random chars.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Internal endpoint secret for crediting eligible-chat earnings, >= 32 chars.
# Generate separately from SESSION_SECRET.
EARNINGS_ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Email (password reset)
# ---------------------------------------------------------------------------
# MAIL_MODE: "log" prints emails to the server log (local development only).
# "resend" delivers via the Resend HTTP API and requires RESEND_API_KEY.
MAIL_MODE=log
MAIL_FROM=EarnChat <no-reply@earnchat.local>
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Payment provider
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER: "nexus_pay" (default) uses Makamesco Nexus Pay, which
# handles STK Push and calls the
# webhook below. Only one provider is active for new payments; existing pending
# payments are still reconciled only by the provider recorded on the payment.
PAYMENT_PROVIDER=nexus_pay

# ---------------------------------------------------------------------------
# Nexus Pay (Makamesco)
# ---------------------------------------------------------------------------
# Secret API key from the Nexus Pay dashboard (sk_... or sb_..., never pk_...).
NEXUS_PAY_API_KEY=
# Webhook signing secret shown when the endpoint is created in the dashboard.
NEXUS_PAY_WEBHOOK_SECRET=
# API origin from the dashboard. Live API: https://makamescopay.com
NEXUS_PAY_API_BASE_URL=https://makamescopay.com
# Optional request timeout for Nexus Pay API calls.
NEXUS_PAY_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Safaricom Daraja (M-Pesa)
# ---------------------------------------------------------------------------
# Used when PAYMENT_PROVIDER=daraja.
# MPESA_MODE: "mock" simulates Daraja locally (no real prompts, no credentials).
# "live" uses the credentials below against sandbox or production.
MPESA_MODE=mock
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:3000/api/webhooks/mpesa
# Optional defense-in-depth: comma-separated IPs / IPv4 CIDRs allowed to call the
# webhook. Leave empty to accept any source (entitlement is still gated by an
# authoritative STK Query, so a forged callback cannot grant access on its own).
MPESA_WEBHOOK_ALLOWED_IPS=

# ---------------------------------------------------------------------------
# Worker (polls the database for pending payments)
# ---------------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=5000
PAYMENT_PENDING_TTL_MS=180000
